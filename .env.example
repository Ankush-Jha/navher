# NavHer — Firebase Frontend Config
# Get these values from Firebase Console → Project Settings → Your Apps → navher-web → Config
# NEVER commit this file. It is in .gitignore.

VITE_FIREBASE_API_KEY=AIzaSy_YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps (for real map tiles) — get from Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_MAPS_KEY_HERE
